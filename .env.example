# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1

# ── Database ─────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/institute_management
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/institute_management
MONGODB_URI=mongodb://127.0.0.1:27017/institute_management

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d

# ── CORS ─────────────────────────────────────────────────────
# Admin dashboard origin
FRONTEND_URL=http://localhost:3000
# Your existing static institute website origin(s), comma separated
PUBLIC_WEBSITE_URL=http://localhost:8080,https://www.yourinstitute.com

# ── Cookies ──────────────────────────────────────────────────
COOKIE_SECRET=change_this_cookie_secret

# ── Storage ──────────────────────────────────────────────────
# local | s3 | cloudinary | azure | r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# ── Rate limiting ────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
PUBLIC_ENQUIRY_THROTTLE_TTL=60
PUBLIC_ENQUIRY_THROTTLE_LIMIT=5

# ── Seed (Owner account) ─────────────────────────────────────
SEED_OWNER_FIRST_NAME=Institute
SEED_OWNER_LAST_NAME=Owner
SEED_OWNER_EMAIL=owner@yourinstitute.com
SEED_OWNER_PASSWORD=ChangeMe@12345
SEED_OWNER_MOBILE=9999999999
